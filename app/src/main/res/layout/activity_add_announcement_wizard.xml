<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FF">

    <!-- ══ HEADER ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_create_header"
        android:padding="18dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvPostTypeHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@android:color/white"
                android:contentDescription="Close"/>
        </RelativeLayout>

        <!-- Step progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvStepIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#EAF0FF"
                android:textSize="12sp"/>

            <View android:id="@+id/indicatorDot1" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_wizard_dot"/>
            <View android:id="@+id/indicatorLine1" android:layout_width="20dp" android:layout_height="2dp" android:background="#FFFFFF" android:alpha="0.4" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"/>
            <View android:id="@+id/indicatorDot2" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_wizard_dot" android:alpha="0.4"/>
            <View android:id="@+id/indicatorLine2" android:layout_width="20dp" android:layout_height="2dp" android:background="#FFFFFF" android:alpha="0.4" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"/>
            <View android:id="@+id/indicatorDot3" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_wizard_dot" android:alpha="0.4"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ══ STEP 1: CATEGORY SELECTION ══ -->
    <ScrollView
        android:id="@+id/stepCategory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStep1Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#111111"/>

            <TextView
                android:id="@+id/tvStep1Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:id="@+id/llCategoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <Button
                android:id="@+id/btnNextStep1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_btn_publish"/>

        </LinearLayout>
    </ScrollView>

    <!-- ══ STEP 2: POST DETAILS & VOICE BROADCAST (Swapped with Step 3) ══ -->
    <ScrollView
        android:id="@+id/stepDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStep2Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#111111"/>

            <TextView
                android:id="@+id/tvStep2Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"/>


            <!-- Title input -->
            <TextView
                android:id="@+id/tvLabelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#202020"/>

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="14sp"/>

            <!-- Description input -->
            <TextView
                android:id="@+id/tvLabelDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#202020"/>

            <EditText
                android:id="@+id/etDesc"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="6dp"
                android:gravity="top"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="14sp"/>

            <!-- Image + Audio Record Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnAddImage"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_soft"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="10dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#2563EB"/>
                    <TextView
                        android:id="@+id/tvBtnAddImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textStyle="bold"
                        android:textColor="#2563EB"/>
                </LinearLayout>

                <Space android:layout_width="10dp" android:layout_height="1dp"/>

                <LinearLayout
                    android:id="@+id/btnRecordAudio"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_soft"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="10dp">
                    <ImageView
                        android:id="@+id/ivBtnAddAudio"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_btn_speak_now"
                        app:tint="#A21CAF"/>
                    <TextView
                        android:id="@+id/tvBtnAddAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textStyle="bold"
                        android:textColor="#A21CAF"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvImageStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="#4B5563"/>

            <!-- Multiple Image Preview Container -->
            <HorizontalScrollView
                android:id="@+id/hsvImagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llImagePreviews"
                    android:layout_width="wrap_content"
                    android:layout_height="120dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"/>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvAudioStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="#4B5563"/>

            <!-- Audio Player Preview -->
            <LinearLayout
                android:id="@+id/llAudioPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_soft"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnPlayAudio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#A21CAF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Play audio" />

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="0:00"
                    android:textSize="14sp"
                    android:textColor="#A21CAF"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnDeleteAudio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#EF4444"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete audio" />
            </LinearLayout>

            <!-- 🎙️ Voice recognition & auto-selected status from Audio -->
            <TextView
                android:id="@+id/tvVoiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="10dp"
                android:textSize="13sp"
                android:textColor="#1565C0"
                android:background="#E3F2FD"
                android:visibility="gone"/>

            <!-- ══ EXPIRY SECTION ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFF8F0"
                android:padding="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLabelExpiry"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#202020"/>

                    <TextView
                        android:id="@+id/tvExpiryMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#EF4444"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExpiryInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:textSize="12sp"
                    android:textColor="#6B7280"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etExpiryValue"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:background="@drawable/bg_input"
                        android:padding="14dp"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:gravity="center"/>

                    <Space android:layout_width="10dp" android:layout_height="1dp"/>

                    <Spinner
                        android:id="@+id/spExpiryUnit"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_spinner_white"
                        android:spinnerMode="dropdown"
                        android:popupBackground="@drawable/bg_spinner_popup_white"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExpiryPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="10dp"
                    android:text=""
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1976F3"
                    android:gravity="center"
                    android:visibility="gone"
                    android:background="#E3F2FD"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnNextStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#1565C0"
                    android:background="@drawable/bg_btn_publish"/>

                <Button
                    android:id="@+id/btnBackStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:padding="10dp"
                    android:textAllCaps="false"
                    android:textColor="#1F2937"
                    android:backgroundTint="#E5E7EB"
                    android:background="@drawable/bg_btn_gray"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ══ STEP 3: PRODUCTS & AUTO-SELECTION REVIEW (Swapped with Step 2) ══ -->
    <ScrollView
        android:id="@+id/stepProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStep3Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#111111"/>

            <TextView
                android:id="@+id/tvStep3Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="10dp"/>

            <!-- Auto-selected Voice Banner -->
            <LinearLayout
                android:id="@+id/llAutoSelectedBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E8F5E9"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙️"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvAutoSelectedBanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textSize="13sp"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"/>
            </LinearLayout>

            <EditText
                android:id="@+id/etCustomCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:visibility="gone"
                android:textSize="14sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/llProductList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- Navigation buttons: Back to Step 2 & Publish -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnBackStep3"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_gray"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnPublish"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="2"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_btn_publish"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>