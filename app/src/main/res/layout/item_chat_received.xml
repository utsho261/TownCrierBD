<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:paddingStart="12dp"
    android:paddingEnd="48dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_received"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:maxWidth="290dp">

        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:layout_marginBottom="2dp"/>

        <!-- 1. FB Messenger Style Post / Offer Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPostOffer"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp">

                    <ImageView
                        android:id="@+id/ivPostCardImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_card"
                        android:contentDescription="Post thumbnail"/>

                    <TextView
                        android:id="@+id/tvPostCardBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_badge"
                        android:backgroundTint="#CC000000"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="🎙️ Voice Offer"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:background="#F8FAFC">

                    <TextView
                        android:id="@+id/tvPostCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Offer Title"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/tvPostCardCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Category"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:paddingTop="4dp">

                        <TextView
                            android:id="@+id/tvPostCardAction"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="পোস্ট দেখুন ›"
                            android:textColor="#1565C0"
                            android:textSize="11sp"
                            android:textStyle="bold"/>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_arrow_back"
                            android:rotation="180"
                            app:tint="#1565C0"
                            android:contentDescription="Open"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. Image Message -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardChatImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivChatImage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:contentDescription="Photo message"/>
        </androidx.cardview.widget.CardView>

        <!-- 3. Voice Message Capsule (Black rounded pill with vertical white waveform bars) -->
        <LinearLayout
            android:id="@+id/layoutVoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_voice_capsule"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnPlayVoice"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_play_arrow"
                app:tint="#FFFFFF"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#262626"
                android:contentDescription="Play Voice"/>

            <com.example.towncrierbd.views.WaveformView
                android:id="@+id/waveformVoice"
                android:layout_width="120dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvVoiceDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:15"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 4. Text Message -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message"
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.25"/>

        <!-- 5. Status Footer: Edited indicator, Timestamp -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvEdited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(সম্পাদিত)"
                android:textColor="#64748B"
                android:textSize="9sp"
                android:layout_marginEnd="5dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00 PM"
                android:textColor="#94A3B8"
                android:textSize="10sp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
