<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_recording_dialog"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Red REC badge with dot -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_recording_badge"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/dotRecording"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_recording_dot" />

        <TextView
            android:id="@+id/tvRecordingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="REC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#DC2626" />
    </LinearLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvRecordingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="🎙️ Recording Voice..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:gravity="center" />

    <!-- Big Timer Display -->
    <TextView
        android:id="@+id/tvRecordingTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="00:00"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#DC2626"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05" />

    <!-- Instruction Hint -->
    <TextView
        android:id="@+id/tvRecordingHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Speak your announcement. Tap 'Stop Recording' when finished."
        android:textSize="13sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:lineSpacingExtra="3dp" />

    <!-- Live Recognized Words / Detected Items Preview -->
    <TextView
        android:id="@+id/tvRecordingLiveWords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#EFF6FF"
        android:padding="8dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="#1D4ED8"
        android:gravity="center"
        android:visibility="gone" />

    <Space
        android:layout_width="1dp"
        android:layout_height="14dp" />

    <!-- Big Stop Recording Button -->
    <Button
        android:id="@+id/btnStopRecording"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_btn_recording_stop"
        android:text="⏹ Stop Recording"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        app:backgroundTint="@null" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btnCancelRecording"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:text="Cancel"
        android:textColor="#64748B"
        android:textSize="14sp"
        app:backgroundTint="@null" />

</LinearLayout>
