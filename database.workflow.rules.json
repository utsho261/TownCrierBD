{
  "rules": {
    "categories": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chats": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "app_update": {
      ".read": true,
      ".write": "auth != null"
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "userId",
        "acceptedByUid",
        "expireAt"
      ]
    },
    "requestTracking": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "requestNotifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": [
          "read",
          "timestamp"
        ],
        "$event": {
          ".write": false,
          "read": {
            ".write": "auth != null && auth.uid === $uid && data.exists() && newData.val() === true"
          }
        }
      }
    },
    "postInteractions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "speechUsage": {
      ".read": false,
      ".write": false
    },
    "broadcasts": {
      ".read": false,
      ".write": false
    }
  }
}
